+"""A pool batch with more shader bytes than SPILL_BYTES comes back to the parent through a file, not the pipe.
+
+On Windows one pipe write above 4 GiB fails (OSError: [WinError 87], CPython's _winapi.WriteFile): a batch of 16 of Pokémon
+Pokopia's files carried more shader code than that, and the split ended with nothing written. Without game data: scan_file is
+replaced by results of chosen sizes, and SPILL_BYTES is made small.
+"""
+from pathlib import Path
+import concurrent.futures as cf
+import os
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+import shader_split
+
+
+def result(rel, code_bytes):
+    """A scan_file result: (relative path, {key: (where, stage, control, code)}, pairs, extra)."""
+    uniq = {f'{rel}-k': (f'/{rel}', 'fragment', b'C' * 16, b'X' * code_bytes)} if code_bytes else {}
+    return rel, uniq, set(), {}
+
+
+class SpillTests(unittest.TestCase):
+    def setUp(self):
+        self.td = tempfile.TemporaryDirectory()
+        self.addCleanup(self.td.cleanup)
+        for p in (mock.patch.dict(os.environ, {'DM_SPLIT_SPILL_DIR': self.td.name}),
+                  mock.patch.object(shader_split, 'SPILL_BYTES', 1000)):
+            p.start()
+            self.addCleanup(p.stop)
+
+    def batch(self, results):
+        with mock.patch.object(shader_split, 'scan_file', side_effect=list(results)):
+            return shader_split.scan_batch([(r[0], r[0]) for r in results])
+
+    def test_shader_bytes_counts_the_control_sections_and_the_code(self):
+        self.assertEqual(shader_split.shader_bytes(result('a', 100)), 116)
+        self.assertEqual(shader_split.shader_bytes(result('a', 0)), 0)
+        self.assertEqual(shader_split.shader_bytes(('a', {}, set(), ('unreadable', 'why', 1))), 0)
+
+    def test_a_small_batch_goes_through_the_pipe_as_before(self):
+        small = [result('a', 100), result('b', 200)]
+        out = self.batch(small)
+        self.assertEqual(out, small)
+        self.assertEqual(shader_split.batch_result(out), small)
+        self.assertEqual(os.listdir(self.td.name), [])
+
+    def test_a_large_batch_comes_back_whole_through_a_file_that_is_then_removed(self):
+        large = [result('a', 600), result('b', 600), result('c', 0)]
+        out = self.batch(large)
+        self.assertEqual(out[0], 'spilled')
+        self.assertEqual(Path(out[1]).parent, Path(self.td.name))
+        self.assertEqual(shader_split.batch_result(out), large)
+        self.assertFalse(Path(out[1]).exists())
+
+    def test_pooled_keeps_the_job_order_with_spilled_and_piped_batches(self):
+        sizes = {'a': 900, 'b': 900, 'c': 10, 'd': 10, 'e': 5}
+        fake = lambda job: result(job[1], sizes[job[1]])   # noqa: E731
+        jobs = [(k, k) for k in sizes]
+        with mock.patch.object(shader_split, 'scan_file', side_effect=fake), cf.ThreadPoolExecutor(2) as ex, \
+                mock.patch('builtins.print'):
+            out = shader_split.pooled(ex, jobs, len(jobs), chunk=2)
+        self.assertEqual([r[0] for r in out], list(sizes))
+        self.assertEqual([shader_split.shader_bytes(r) for r in out], [916, 916, 26, 26, 21])
+        self.assertEqual(os.listdir(self.td.name), [], 'every spilled batch was read back and removed')
+
+
+if __name__ == '__main__':
+    unittest.main()
