+# A pool result goes back to the parent in one pipe write, and on Windows that write fails above 4 GiB (OSError: [WinError 87], CPython's
+# _winapi.WriteFile): a batch of 16 of Pokémon Pokopia's files carried more shader code than that, and the split ended at 79/79 with nothing
+# written. A batch whose shader bytes pass SPILL_BYTES is pickled to a file instead (beside the shader map, DM_SPLIT_SPILL_DIR), and the
+# parent reads it back and removes it (batch_result). Smaller batches go through the pipe as before.
+SPILL_BYTES = 1 << 30
+
+def shader_bytes(result):   # the control sections and code a scan_file result carries, the bulk of what it sends back
+    uniq = result[1] if isinstance(result, tuple) and len(result) > 1 else None
+    if not isinstance(uniq, dict): return 0
+    n = 0
+    for v in uniq.values():
+        if isinstance(v, tuple) and len(v) >= 4:
+            n += sum(len(part) for part in v[2:4] if hasattr(part, '__len__'))
+    return n
+
 def scan_batch(jobs):   # scan_file over a batch of jobs, in a pool worker
-    return [scan_file(j) for j in jobs]
+    out = [scan_file(j) for j in jobs]
+    if sum(shader_bytes(r) for r in out) < SPILL_BYTES: return out
+    import pickle, tempfile
+    fd, path = tempfile.mkstemp(prefix='split-batch-', suffix='.pickle', dir=os.environ.get('DM_SPLIT_SPILL_DIR') or None)
+    with os.fdopen(fd, 'wb') as f: pickle.dump(out, f, protocol=pickle.HIGHEST_PROTOCOL)
+    return ('spilled', path)
+
+def batch_result(r):   # a scan_batch result, read back from its file when the worker spilled it
+    if not (isinstance(r, tuple) and len(r) == 2 and r[0] == 'spilled'): return r
+    import pickle
+    try:
+        with open(r[1], 'rb') as f: return pickle.load(f)
+    finally:
+        try: os.remove(r[1])
+        except OSError: pass
 
 
 def pooled(ex, jobs, total, start=0, chunk=1):
@@ -3173,16 +3202,20 @@ def pooled(ex, jobs, total, start=0, chunk=1):
     the stage's count). The count is of the jobs finished in any order: counted in order it would stall behind one slow archive range while the others finish"""
     batches = [jobs[i:i + chunk] for i in range(0, len(jobs), chunk)]
     futures = {ex.submit(scan_batch, b): len(b) for b in batches}
-    done, pending, shown = start, set(futures), 0.0
+    done, pending, shown, got = start, set(futures), 0.0, {}
     while pending:
         finished, pending = cf.wait(pending, timeout=0.5)
+        for f in finished: got[f] = batch_result(f.result())   # a spilled batch is read back (and its file removed) as soon as it is done
         done += sum(futures[f] for f in finished)
         if not pending or time.monotonic() - shown >= 0.5: print(f'progress: {done}/{total}', flush=True); shown = time.monotonic()
-    return [r for f in futures for r in f.result()]
+    return [r for f in futures for r in got[f]]
 
 
