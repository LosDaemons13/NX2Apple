+        write(self.root / '.off/exefs/x.pchtxt', PCHTXT)
+        write(self.root / 'c/exefs_patches/other/0123.ips', ips([(0x104, b'\x02')]))
+        mods = exefs_mods.mod_folders(self.root)
+        self.assertEqual([Path(m).name for m in mods], ['a', 'b', 'c'])
+        self.assertEqual(exefs_mods.mod_ids(mods[0]), {BID[:32]: [str(self.root / 'a/atmosphere/exefs_patches/fps' / f'{BID[:32].upper()}.ips')]})
+        got = patches_for(BID[:32], mods)
+        self.assertEqual([(label, p.address) for label, p in got], [('a', 4), ('b', 0x2b7a874), ('b', 0xb92780), ('b', 0x3c2fbb0)])
