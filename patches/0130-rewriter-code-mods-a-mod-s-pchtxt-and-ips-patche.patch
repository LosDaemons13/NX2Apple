+class Rewriter(unittest.TestCase):
+    """patch_nso.py writes the mods for its module's build before it reads the code: a mod's instruction that names no x18 runs as the mod has it, the module's own is rewritten"""
+    def module(self):   # test_nro_header's NRO: mov x18, x0; ret at 0x80, read-only data from 0x1000
+        raw = image({0x80: [0xaa0003f2, RET]})
+        raw[0x1100:0x111c] = raw[0x20:0x3c]
+        struct.pack_into('<I', raw, 4, 0x1100)
+        struct.pack_into('<ii', raw, 0x1110, 0x3000 - 0x1100, 0x3014 - 0x1100)
+        raw[0x10:0x14] = b'NRO0'
+        struct.pack_into('<I', raw, 0x18, len(raw))
+        struct.pack_into('<6I', raw, 0x20, 0, 0x1000, 0x1000, 0x2000, 0x3000, 0x1000)
+        struct.pack_into('<I', raw, 0x38, 0)
+        raw[0x40:0x50] = bytes.fromhex(BID[:32])
+        return raw
+
+    def rewrite(self, tmp, mods):
+        src = Path(tmp) / 'input.nro'; src.write_bytes(self.module())
+        out = Path(tmp) / 'out'; out.mkdir(exist_ok=True)
+        env = {k: v for k, v in os.environ.items() if k != 'DM_EXEFS_MODS'} | {'DM_GAME': '010015100B514000'}
+        if mods: env['DM_EXEFS_MODS'] = os.pathsep.join(str(m) for m in mods)
+        return subprocess.run([sys.executable, str(TOOLS / 'patch_nso.py'), str(src), str(out), 'main'], env=env, capture_output=True, text=True), out
+
+    def test_mod_written_before_the_rewrite(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            write(Path(tmp, 'mods/fps/exefs/x.pchtxt'), f'@nsobid-{BID}\n@flag offset_shift 0x100\n@enabled\n00000080 E10300AA\n00001800 DEADBEEF\n')
+            write(Path(tmp, 'mods/other/exefs/y.pchtxt'), '@nsobid-0123\n@flag offset_shift 0x100\n@enabled\n00001800 00000000\n')   # another build: not applied
+            run, out = self.rewrite(tmp, [Path(tmp, 'mods/fps'), Path(tmp, 'mods/other')])
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            patched = (out / 'main.patched.bin').read_bytes()
+            self.assertEqual(patched[0x80:0x84], bytes.fromhex('e10300aa'))   # mov x1, x0: no x18, nothing to rewrite
+            self.assertEqual(patched[0x1800:0x1804], bytes.fromhex('deadbeef'))
+            rows = [l.split('\t') for l in (out / 'main.mods.tsv').read_text().splitlines() if not l.startswith('#')]
+            self.assertEqual([r[:3] for r in rows], [['fps', '0x80', 'e10300aa'], ['fps', '0x1800', 'deadbeef']])
+            self.assertIn('main: code mods: fps (2 patches)', run.stdout)
+
+            run, out = self.rewrite(tmp, [])   # without mods the module's own x18 instruction is rewritten and no list is written
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotEqual((out / 'main.patched.bin').read_bytes()[0x80:0x84], bytes.fromhex('f20300aa'))
+            self.assertFalse((out / 'main.mods.tsv').exists())
+
+    def test_a_mod_that_names_x18_is_rewritten_too(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            write(Path(tmp, 'mods/fps/exefs/x.pchtxt'), f'@nsobid-{BID}\n@flag offset_shift 0x100\n@enabled\n00000080 F20301AA\n')   # mov x18, x1
+            run, out = self.rewrite(tmp, [Path(tmp, 'mods/fps')])
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotEqual((out / 'main.patched.bin').read_bytes()[0x80:0x84], bytes.fromhex('f20301aa'))
+
+    def test_a_write_past_the_module_stops_with_a_red_line(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            write(Path(tmp, 'mods/big/exefs/x.pchtxt'), f'@nsobid-{BID}\n@flag offset_shift 0x100\n@enabled\n00100000 00\n')
+            run, _ = self.rewrite(tmp, [Path(tmp, 'mods/big')])
+            self.assertNotEqual(run.returncode, 0)
+            self.assertIn('[RED] main: code mod big', run.stderr)
+            self.assertNotIn('Traceback', run.stderr)
+
+
+if __name__ == '__main__': unittest.main()
