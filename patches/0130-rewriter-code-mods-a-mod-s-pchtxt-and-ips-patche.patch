+++ b/dm/tools/exefs_mods.py
@@ -0,0 +1,188 @@
+"""Code mods: the byte patches of a mod's exefs/ (yuzu's and Ryujinx's layout, Atmosphere's exefs_patches/), applied to a module before the rewriter reads it.
+
+A mod is a folder. Its code patches are files in `<mod>/exefs/`, `<mod>/exefs_patches/<name>/` or `<mod>/atmosphere/exefs_patches/<name>/`:
+- `.pchtxt` (IPSwitch text): `@nsobid-<build ID>` names the module, `@flag offset_shift <n>` the shift, `@enabled` / `@disabled` switch the lines after them on and off, `@stop` ends the
+  file, `@little-endian` / `@big-endian` the order of hex values (big-endian, as written, by default). A line `<hex offset> <hex bytes>` or `<hex offset> "text"` is one patch; `//` starts a comment,
+  a line that starts with `#` is a comment.
+- `.ips` (IPS: `PATCH` … `EOF`, 3-byte offsets) and IPS32 (`IPS32` … `EEOF`, 4-byte offsets), RLE records included; the file name is the build ID of the module it patches.
+Both address the module as Horizon's loader does: offset 0x100 (the NSO header's size) is the module's first byte, so a module address is offset + shift - 0x100 (a .pchtxt with
+`@flag offset_shift 0x100` gives module addresses). A build ID matches on its first 16 bytes, the part the tools key on (nso.Module.build_id), a shorter one padded with zeros.
+
+A mod that replaces modules (`exefs/main`, `exefs/subsdk*`, `exefs/main.npdm`: exlaunch and its kind) adds code the rewriter does not load; `replaced_modules` names those files and they are not applied.
+
+patch_nso.py applies the patches of the folders in DM_EXEFS_MODS (separated by os.pathsep) to the module whose build ID they name, before anything else reads its code, so the rewriter, the
+function matchers and <name>.changed.tsv see the code as the mod makes it. Two mods that write different bytes to one address stop the rewrite. Pure stdlib."""
+import os
+import re
+import sys
+from typing import NamedTuple
+
+HEADER = 0x100   # an NSO header: IPS offsets count from the file's start, which Horizon's loader maps 0x100 bytes before the module
+ID_LEN = 0x10    # the bytes of a build ID that name a module (nso.Module.build_id[:0x10])
+PATCH_EXT = ('.pchtxt', '.ips')
+MODULE_FILES = re.compile(r'(main|rtld|sdk|subsdk\d+)(\.npdm)?$', re.IGNORECASE)
+
+
+class Patch(NamedTuple):
+    address: int   # module offset
+    data: bytes
+    source: str    # the file and line (or record) it comes from
+
+
+class Error(ValueError):
+    pass
+
+
+def norm_id(text):
+    """A build ID as the tools key on it: lowercase hex of its first 16 bytes, a shorter one padded with zeros; None when text is no hex"""
+    text = text.strip().lower()
+    if not text or not re.fullmatch(r'[0-9a-f]+', text): return None
+    return (text + '0' * (2 * ID_LEN))[:2 * ID_LEN]
+
+
+def mod_folders(root):
+    """The mods of a folder of mods: its subfolders in name order, without those whose name starts with a dot (switched off)"""
+    try: names = sorted(os.listdir(root), key=str.lower)
+    except OSError: return []
+    return [os.path.join(root, n) for n in names if not n.startswith('.') and os.path.isdir(os.path.join(root, n))]
+
+
+def patch_dirs(mod):
+    """The folders of a mod that hold code patches"""
+    out = []
+    for sub in ('exefs', 'exefs_patches', os.path.join('atmosphere', 'exefs_patches')):
+        d = os.path.join(mod, sub)
+        if not os.path.isdir(d): continue
+        if sub == 'exefs': out.append(d)
+        else: out += [os.path.join(d, n) for n in sorted(os.listdir(d), key=str.lower) if os.path.isdir(os.path.join(d, n))]
+    return out
+
+
+def patch_files(mod):
+    """The .pchtxt and .ips files of a mod, in a stable order"""
+    return [os.path.join(d, n) for d in patch_dirs(mod) for n in sorted(os.listdir(d), key=str.lower)
+            if n.lower().endswith(PATCH_EXT) and os.path.isfile(os.path.join(d, n))]
+
+
+def replaced_modules(mod):
+    """Files of the mod's exefs/ that replace or add a module (exlaunch's subsdk and main.npdm): code the rewriter does not take"""
+    d = os.path.join(mod, 'exefs')
+    try: return sorted(n for n in os.listdir(d) if MODULE_FILES.match(n) and os.path.isfile(os.path.join(d, n)))
+    except OSError: return []
+
+
+def _unescape(s):
+    return s.encode('utf-8').decode('unicode_escape').encode('latin-1')
+
+
+def parse_pchtxt(text, name='patch.pchtxt'):
+    """(build ID or None, [Patch]) of an IPSwitch text; only the lines under @enabled count"""
+    bid, shift, enabled, little, out = None, 0, False, False, []
+    for n, raw in enumerate(text.splitlines(), 1):
+        line = raw.strip()
+        if not line or line.startswith('#') or line.startswith('//'): continue
+        if line.startswith('@'):
+            word = line.split()[0].lower()
+            if word.startswith('@nsobid-'):
+                bid = norm_id(word[len('@nsobid-'):])
+                if bid is None: raise Error(f'{name}:{n}: {line!r} names no build ID')
+            elif word == '@stop': break
+            elif word == '@enabled': enabled = True
+            elif word == '@disabled': enabled = False
+            elif word == '@little-endian': little = True
+            elif word == '@big-endian': little = False
+            elif word == '@flag':
+                parts = line.split()
+                if len(parts) >= 3 and parts[1].lower() == 'offset_shift':
+                    try: shift = int(parts[2], 0)
+                    except ValueError: raise Error(f'{name}:{n}: offset_shift {parts[2]!r} is no number') from None
+            continue   # any other @ line (an author's name) is not a patch
+        if not enabled: continue
+        m = re.match(r'([0-9A-Fa-f]{1,8})\s+(.*)$', line)
+        if not m: raise Error(f'{name}:{n}: {line!r} is not "<hex offset> <hex bytes>" or "<hex offset> \\"text\\""')
+        off, rest = int(m.group(1), 16), m.group(2)
+        if rest.startswith('"'):
+            end = rest.find('"', 1)
+            while end > 0 and rest[end - 1] == '\\': end = rest.find('"', end + 1)
+            if end < 0: raise Error(f'{name}:{n}: the text has no closing quote')
+            data = _unescape(rest[1:end])
+        else:
+            value = rest.split('//', 1)[0].strip()
+            if not re.fullmatch(r'(?:[0-9A-Fa-f]{2})+', value): raise Error(f'{name}:{n}: {value!r} is not whole bytes of hex')
+            data = bytes.fromhex(value)
+            if little: data = data[::-1]
+        out.append(Patch(off + shift - HEADER, data, f'{name}:{n}'))
+    return bid, out
+
+
+def parse_ips(blob, name='patch.ips'):
+    """[Patch] of an IPS or IPS32 file"""
+    if blob.startswith(b'IPS32'): pos, width, end = 5, 4, b'EEOF'
+    elif blob.startswith(b'PATCH'): pos, width, end = 5, 3, b'EOF'
+    else: raise Error(f'{name}: not an IPS file (no PATCH or IPS32 header)')
+    out = []
+    while True:
+        if blob[pos:pos + len(end)] == end and pos + len(end) >= len(blob) - 3: break   # an IPS may carry a 3-byte truncation size after EOF
+        if pos + width + 2 > len(blob): raise Error(f'{name}: cut short at {pos:#x} (no {end.decode()} record)')
+        off = int.from_bytes(blob[pos:pos + width], 'big'); size = int.from_bytes(blob[pos + width:pos + width + 2], 'big'); pos += width + 2
+        if size:
+            data = blob[pos:pos + size]; pos += size
+        else:
+            if pos + 3 > len(blob): raise Error(f'{name}: an RLE record cut short at {pos:#x}')
+            count = int.from_bytes(blob[pos:pos + 2], 'big'); data = blob[pos + 2:pos + 3] * count; pos += 3
+        if len(data) != (size or len(data)): raise Error(f'{name}: a record at {pos:#x} is cut short')
+        out.append(Patch(off - HEADER, data, f'{name}@{off:#x}'))
+    return out
+
+
+def load_file(path):
+    """(build ID or None, [Patch]) of one patch file; an .ips file's build ID is its name"""
+    base = os.path.basename(path)
+    if base.lower().endswith('.pchtxt'):
+        with open(path, encoding='utf-8', errors='replace') as f: return parse_pchtxt(f.read(), base)
+    with open(path, 'rb') as f: blob = f.read()
+    return norm_id(os.path.splitext(base)[0]), parse_ips(blob, base)
+
+
+def mod_ids(mod):
+    """{build ID: [patch files]} of a mod, files without a patch switched on left out; files that name no build ID, or cannot be read, are under None"""
+    out = {}
+    for p in patch_files(mod):
+        try: bid, patches = load_file(p)
+        except (OSError, Error): bid, patches = None, True
+        if patches: out.setdefault(bid, []).append(p)
+    return out
+
+
+def patches_for(build_id, mods):
+    """The patches of the mods (folders, in order) for the module of build_id: [(mod name, Patch)]; raises Error on a damaged file or when two mods write different bytes to one byte"""
+    want, out, owner = norm_id(build_id), [], {}
+    for mod in mods:
+        label = os.path.basename(os.path.normpath(mod))
+        for p in patch_files(mod):
+            bid, patches = load_file(p)
+            if bid != want: continue
+            for pt in patches:
+                if pt.address < 0: raise Error(f'{label}: {pt.source} writes before the module ({pt.address:#x}): the NSO header cannot be patched')
+                for i, b in enumerate(pt.data):
+                    prev = owner.get(pt.address + i)
+                    if prev and prev[0] != label and prev[1] != b:
+                        raise Error(f'mods {prev[0]!r} and {label!r} write different bytes to {pt.address + i:#x} ({prev[2]} and {pt.source}): switch one of them off')
+                    owner[pt.address + i] = (label, b, pt.source)
+                out.append((label, pt))
+    return out
+
+
+def apply(img, patches, limit):
+    """Write the patches into img (a bytearray) where they fall below limit; returns those at or past it, for the caller to place or refuse"""
+    rest = []
+    for label, pt in patches:
+        if pt.address + len(pt.data) <= limit: img[pt.address:pt.address + len(pt.data)] = pt.data
+        else: rest.append((label, pt))
+    return rest
+
+
+if __name__ == '__main__':   # exefs_mods.py <build ID> <mod>...: the patches the mods have for that module
+    try:
+        for label, pt in patches_for(sys.argv[1], sys.argv[2:]): print(f'{label}\t{pt.address:#x}\t{pt.data.hex()}\t{pt.source}')
+    except (Error, IndexError) as e: sys.exit(f'[RED] {e}')
diff --git a/dm/tools/patch_nso.py b/dm/tools/patch_nso.py
index ceeef78..9475dd3 100644
--- a/dm/tools/patch_nso.py
+++ b/dm/tools/patch_nso.py
@@ -9,6 +9,7 @@
 #   ldxr* / ldxp → ldaxr* / ldaxp, stxr* / stxp → stlxr* / stlxp: every exclusive access gets acquire or release ordering (exclusive_order_sites; the games ran on the Switch's Cortex-A57 without it, Apple cores need it)
 #   the completer of Trinity's per-frame rendezvous: dmb ish between its flag store and its load of the state word (trinity_completer_sites; exactly one such function in a module, or no change)
 #   spin wait loops     → a copy whose back-edges pass a spin gate (the host yields there; a busy poll costs nothing on the Switch, see "Spin waits")
+#   Code mods (DM_EXEFS_MODS, exefs_mods.py): the .pchtxt / .ips patches a mod has for this build, written into the image before anything reads it; listed in <name>.mods.tsv
 #   Registered cuts (CUTS of the patch files, restricted by NSO build ID, see "Registered patches"): before rewriting, the original bytes are asserted one by one and any mismatch aborts; results are listed in <name>.cuts.tsv
 #   Function-matched cuts (MATCH_CUTS of the selected game's patches.py): unknown builds only, unique complete-function and direct-callee fingerprints, then original-byte assertions
 #   Registered observation gates (OBS of the patch files, restricted by build ID): one instruction at the entry is replaced with "enter the host observation callback → execute the original instruction → jump back", so diagnostics modify zero code at runtime; listed in <name>.obs.tsv
@@ -35,6 +36,22 @@ src, outdir, NAME = sys.argv[1], sys.argv[2], sys.argv[3]
 # against its header before anything is allocated (a damaged module stops here with a [RED] line)
 MOD = nso.cli_read(src)
 bss = MOD.bss
+# ---- Code mods (exefs_mods.py): the byte patches the folders of DM_EXEFS_MODS have for this module's build, written before anything reads its code, as Horizon's loader applies
+# them before the game starts, so the rewriter, the function matchers and <name>.changed.tsv see the code the mod makes. Patches past the file's segments (into bss) are placed with bss below
+import exefs_mods
+MOD_DIRS = [d for d in os.environ.get('DM_EXEFS_MODS', '').split(os.pathsep) if d]
+try: MOD_PATCHES = exefs_mods.patches_for(MOD.build_id[:0x10].hex(), MOD_DIRS) if MOD_DIRS else []
+except (exefs_mods.Error, OSError) as e: sys.exit(f'[RED] {NAME}: code mod: {e}')
+MOD_BSS = exefs_mods.apply(MOD.image, MOD_PATCHES, len(MOD.image))
+if MOD_PATCHES:
+    os.makedirs(outdir, exist_ok=True)
+    with open(os.path.join(outdir, NAME + '.mods.tsv'), 'w', encoding='utf-8') as f:
+        f.write(f'# {NAME} {MOD.build_id[:0x10].hex()}: the code mods\' patches written before the rewrite. Columns: mod, offset, bytes, source\n')
+        for label, pt in MOD_PATCHES: f.write(f'{label}\t{pt.address:#x}\t{pt.data.hex()}\t{pt.source}\n')
+    print(f'{NAME}: code mods: ' + ', '.join(f'{label} ({n} patches)' for label, n in {l: sum(1 for x, _ in MOD_PATCHES if x == l) for l, _ in MOD_PATCHES}.items()))
+else:   # an output folder used again: no list of an earlier rewrite's mods
+    try: os.remove(os.path.join(outdir, NAME + '.mods.tsv'))
+    except FileNotFoundError: pass
 # Every jump between the patch area and the code is a B (±128 MB). A patch area appended after the image (with bss) cannot reach the code when it would start beyond 112 MB (leaving 16 MB for the patch area): Metroid Dread's main has about 1.8 GB of bss (the engine's static heap); Engage's main starts its patch area at about 103 MB and keeps it after the image.
 # The patch area then sits FRONT bytes before the module base (PATCH_OFF is negative), and the output file holds only text + ro + data (FILE_IMAGE_LEN) followed by the patch area; the loader supplies zero pages for bss and the key page (IMAGE_SIZE is the whole image).
 # The key page stays after bss (the patch area reaches it through ADRP, ±4 GB). Modules below the limit produce output byte-identical to before
@@ -61,6 +78,10 @@ SPLIT = max(0x8000000 - FRONT - 0x100000, BACK_MIN) if TWO else None
 IMG = MOD.image
 ORIG_TEXT = bytes(IMG[:MOD.text_end])   # the text as the file has it, before any cut or site: <name>.changed.tsv compares against it
 if not FAR: IMG.extend(bytes(bss))
+if MOD_BSS:   # a mod's variables in bss: the image carries bss only when the patch area follows it
+    if FAR or exefs_mods.apply(IMG, MOD_BSS, len(IMG)):
+        label, pt = MOD_BSS[0]
+        sys.exit(f'[RED] {NAME}: code mod {label}: {pt.source} writes {pt.address:#x}..{pt.address + len(pt.data):#x}, past the module\'s segments' + (' (bss, which this module\'s file does not hold)' if FAR else ''))
 TEXT_END = MOD.text_end
 RO_OFF, DATA_OFF = MOD.segments[1][0], MOD.segments[2][0]
 if FAR:
@@ -168,6 +189,8 @@ if (BUILD_ID in PATCHES['FRAME_STEP'] or FS_MATCH) and NAME == 'main' and not FA
     PATCH_OFF += 0x10000
 for off, ob, nb, why in cuts:
     ob, nb = bytes.fromhex(ob), bytes.fromhex(nb)
+    hit = next((label for label, pt in MOD_PATCHES if pt.address < off + len(ob) and off < pt.address + len(pt.data)), None) if IMG[off:off + len(ob)] != ob else None
+    if hit: sys.exit(f'[RED] {NAME}: the code mod {hit} changes bytes at {off:#x} that the rewriter\'s cut there needs ({why}): switch the mod off')
     assert len(ob) == len(nb) and IMG[off:off + len(ob)] == ob, f'cut original bytes mismatch {off:#x}: {bytes(IMG[off:off + len(ob)]).hex()}'
     IMG[off:off + len(nb)] = nb
