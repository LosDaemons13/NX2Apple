+++ b/dm/tools/tests/test_exefs_mods.py
@@ -0,0 +1,217 @@
+"""Code mods (dm/tools/exefs_mods.py): .pchtxt and IPS / IPS32 patches, the build ID they name, the mod layouts, and the real rewriter writing them before it reads the code, without game files."""
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+TOOLS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(TOOLS))
+sys.path.insert(0, str(Path(__file__).resolve().parent))   # its sibling test module, also when the file runs alone
+import exefs_mods   # noqa: E402
+from exefs_mods import Error, Patch, parse_ips, parse_pchtxt, patches_for   # noqa: E402
+from test_nso_match import image, RET   # noqa: E402
+
+BID = '421c5411b487eb4d049dd065fec9547773e8e598'   # Pokémon Scarlet 4.0.0's main, as the 60 FPS mod names it: 20 bytes, of which the tools key on 16
+PCHTXT = f"""@nsobid-{BID.upper()}
+
+# Pokemon Scarlet [0100A3D008C5C000] v4.0.0 - 60FPS
+
+@flag print_values
+@flag offset_shift 0x100
+
+// 60FPS
+
+@enabled
+02b7a874 21008052
+00b92780 C10A94D2 // a comment after the value
+@disabled
+00000010 FFFFFFFF
+@enabled
+03c2fbb0 "ab\\x00"
+@stop
+00000020 EEEEEEEE
+
+@Fl4sh
+https://example.invalid/author
+"""
+
+
+def write(path, text):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    (path.write_bytes if isinstance(text, bytes) else path.write_text)(text)
+
+
+def ips(records, big=False):
+    out = bytearray(b'IPS32' if big else b'PATCH')
+    for off, data in records:
+        out += off.to_bytes(4 if big else 3, 'big')
+        if isinstance(data, tuple): out += b'\0\0' + data[0].to_bytes(2, 'big') + bytes([data[1]])   # RLE: (count, byte)
+        else: out += len(data).to_bytes(2, 'big') + data
+    return bytes(out + (b'EEOF' if big else b'EOF'))
+
+
+class Parse(unittest.TestCase):
+    def test_pchtxt_of_the_60_fps_mod(self):
+        bid, got = parse_pchtxt(PCHTXT, 'x.pchtxt')
+        self.assertEqual(bid, BID[:32])
+        self.assertEqual([(p.address, p.data) for p in got],
+                         [(0x2b7a874, bytes.fromhex('21008052')), (0xb92780, bytes.fromhex('c10a94d2')), (0x3c2fbb0, b'ab\0')])
+        self.assertEqual(got[0].source, 'x.pchtxt:11')
+
+    def test_pchtxt_without_shift_counts_from_the_nso_header(self):
+        _, got = parse_pchtxt('@nsobid-01\n@enabled\n00000104 00112233\n')
+        self.assertEqual(got, [Patch(4, bytes.fromhex('00112233'), 'patch.pchtxt:3')])
+
+    def test_pchtxt_little_endian_values(self):
+        _, got = parse_pchtxt('@nsobid-01\n@flag offset_shift 0x100\n@little-endian\n@enabled\n00000000 52800021\n')
+        self.assertEqual(got[0].data, bytes.fromhex('21008052'))
+
+    def test_pchtxt_damaged_lines(self):
+        for text in ('@enabled\n0100 123\n', '@enabled\nnot a patch\n', '@enabled\n0100 "open\n', '@nsobid-xyz\n'):
+            with self.subTest(text=text), self.assertRaises(Error): parse_pchtxt(text)
+
+    def test_ips_and_ips32_with_rle(self):
+        got = parse_ips(ips([(0x104, b'\x01\x02'), (0x200, (3, 0xaa))]))
+        self.assertEqual([(p.address, p.data) for p in got], [(4, b'\x01\x02'), (0x100, b'\xaa\xaa\xaa')])
+        got = parse_ips(ips([(0x1000104, b'\x09')], big=True))
+        self.assertEqual([(p.address, p.data) for p in got], [(0x1000004, b'\x09')])
+        self.assertEqual(parse_ips(ips([(0x104, b'\x01')]) + b'\0\x10\0'), [Patch(4, b'\x01', 'patch.ips@0x104')])   # a truncation size after EOF
+
+    def test_damaged_ips(self):
+        for blob in (b'NOTIPS', ips([(0x104, b'\x01\x02')])[:-4], b'PATCH\0\x01'):
+            with self.subTest(blob=blob), self.assertRaises(Error): parse_ips(blob)
+
+    def test_build_ids_pad_and_cut_to_sixteen_bytes(self):
