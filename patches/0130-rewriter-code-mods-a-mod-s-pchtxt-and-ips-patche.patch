+        write(self.root / 'x/romfs/MaxFl4shBreath.ini', 'fps=60')
+        self.assertEqual(exefs_mods.replaced_modules(self.root / 'x'), ['main.npdm', 'subsdk3'])
+        self.assertEqual(exefs_mods.patch_files(self.root / 'x'), [])
+
+    def test_two_mods_writing_one_byte_differently_stop(self):
+        write(self.root / 'a/exefs/x.pchtxt', '@nsobid-01\n@flag offset_shift 0x100\n@enabled\n00000010 1111\n')
+        write(self.root / 'b/exefs/y.pchtxt', '@nsobid-01\n@flag offset_shift 0x100\n@enabled\n00000011 2222\n')
+        with self.assertRaisesRegex(Error, "'a' and 'b'.*0x11"): patches_for('01', exefs_mods.mod_folders(self.root))
+        write(self.root / 'b/exefs/y.pchtxt', '@nsobid-01\n@flag offset_shift 0x100\n@enabled\n00000011 1122\n')   # the same byte where they meet
