diff --git a/dm/gfx/tools/table_progress.py b/dm/gfx/tools/table_progress.py
new file mode 100644
index 0000000..7997d80
--- /dev/null
+++ b/dm/gfx/tools/table_progress.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+# table_progress.py: the progress of c1_guard.py and cb_extent.py, which read every shader of a library after dmsh_build.py's compile (minutes for a large game: Ocarina of Time's
+# 42,848 shaders took over 20 on one Windows core). dmsh_build.py removes its progress file before it runs them and their environment still names it (DMSH_PROGRESS), so each tool
+# writes its own step there in the same form ({"step", "done", "total"}), and build_ipa_from_nsp.py's ShaderWatch shows that step instead of leaving the compile's last count.
+import json
+import os
+import time
+
+
+def mapped(pool, fn, jobs, step, chunksize=64):
+    """pool.map(fn, jobs) in the same order, writing the step's count to DMSH_PROGRESS at most every half second and once at the end. A pool without imap gives its map"""
+    path, total = os.environ.get("DMSH_PROGRESS"), len(jobs)
+    if not path or not hasattr(pool, "imap"): return pool.map(fn, jobs, chunksize=chunksize)
+    out, last = [], 0.0
+    write(path, step, 0, total)
+    for result in pool.imap(fn, jobs, chunksize=chunksize):
+        out.append(result)
+        now = time.time()
+        if now - last >= 0.5 or len(out) == total:
+            last = now
+            write(path, step, len(out), total)
+    return out
+
+
+def write(path, step, done, total):
+    try:
+        with open(path + ".tmp", "w") as stream: json.dump({"step": step, "done": done, "total": total}, stream)
+        os.replace(path + ".tmp", path)
+    except OSError: pass   # progress never stops the build
diff --git a/dm/tools/tests/test_table_progress.py b/dm/tools/tests/test_table_progress.py
new file mode 100644
index 0000000..46b824f
--- /dev/null
+++ b/dm/tools/tests/test_table_progress.py
@@ -0,0 +1,52 @@
+"""c1_guard.py and cb_extent.py write their progress where dmsh_build.py's was (table_progress.py), and the NSP script shows it (ShaderWatch)."""
+import json
+import os
+import sys
+import tempfile
+import unittest
+from multiprocessing.dummy import Pool
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / 'dm/gfx/tools'))
+import table_progress  # noqa: E402
+
+
+class Mapped(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix='table-progress-'))
+        self.path = self.tmp / 'progress.json'
+
+    def tearDown(self):
+        for p in self.tmp.iterdir(): p.unlink()
+        self.tmp.rmdir()
+
+    def test_the_results_keep_their_order_and_the_last_count_is_written(self):
+        with mock.patch.dict(os.environ, {'DMSH_PROGRESS': str(self.path)}), Pool(4) as pool:
+            got = table_progress.mapped(pool, lambda n: n * n, list(range(200)), 'final check: uniform reads', chunksize=8)
+        self.assertEqual(got, [n * n for n in range(200)])
+        self.assertEqual(json.loads(self.path.read_text()), {'step': 'final check: uniform reads', 'done': 200, 'total': 200})
+        self.assertFalse((self.tmp / 'progress.json.tmp').exists())
+
+    def test_without_a_progress_file_or_imap_it_is_the_pool_map(self):
+        with mock.patch.dict(os.environ, {}, clear=False), Pool(2) as pool:
+            os.environ.pop('DMSH_PROGRESS', None)
+            self.assertEqual(table_progress.mapped(pool, str, [1, 2], 'step'), ['1', '2'])
+        self.assertFalse(self.path.exists())
+
+        class MapOnly:
+            def map(self, fn, jobs, chunksize=1): return [fn(j) for j in jobs]
+        with mock.patch.dict(os.environ, {'DMSH_PROGRESS': str(self.path)}):
+            self.assertEqual(table_progress.mapped(MapOnly(), str, [3], 'step'), ['3'])
+
+    @unittest.skipIf(os.name == 'nt', 'the NSP script imports fcntl')
+    def test_the_nsp_script_shows_the_step(self):
+        sys.path.insert(0, str(ROOT / 'scripts')); sys.path.insert(0, str(ROOT / 'dm/tools'))
+        import build_ipa_from_nsp as nsp
+        table_progress.write(str(self.path), 'final check: c1 reads', 5, 9)
+        self.assertEqual(nsp.ShaderWatch(self.path)(), {'step': 'final check: c1 reads', 'done': 5, 'total': 9, 'unit': 'shaders', 'note': ''})
+
+
+if __name__ == '__main__':
+    unittest.main()
