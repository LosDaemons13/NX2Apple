+// The front end's in-game menu (front.h): any thread
+// A game that imports the amiibo library (main or an NRO) offers amiibo from the start, so a figure can be placed before the game's own amiibo screen
+int dm_amiibo_offered(void) { return atomic_load(&g_nfp_lib) == 1 || dm_game_imports("_ZN2nn3nfp"); }
+void dm_amiibo_place(const char *id_hex, const char *name) {
+    uint8_t id[8];
+    int bad = !id_hex || strlen(id_hex) != 16;
+    for (int i = 0; i < 8 && !bad; i++) { unsigned v; if (sscanf(id_hex + 2 * i, "%2x", &v) != 1) bad = 1; else id[i] = (uint8_t)v; }
+    if (bad) { LOG("[RED] nfp: %s is not an amiibo ID (16 hex digits)", id_hex ? id_hex : "(null)"); return; }
+    pthread_mutex_lock(&g_nfp_mu);
+    void *off = NULL;
+    if (nfp_has_tag()) { nfp_lose_tag(NFP_STATE_SEARCH); off = g_nfp_deactivate; }   // another figure was there: it leaves, and the reader finds this one
+    g_amiibo.placed = 1; memcpy(g_amiibo.id, id, 8);
+    // The nickname holds 10 characters: cut the name there, at a character boundary
+    size_t k = 0; int chars = 0; const char *s = name ? name : "";
+    while (s[k] && chars < 10 && k < sizeof g_amiibo.name - 5) { k++; while ((s[k] & 0xc0) == 0x80) k++; chars++; }
+    memcpy(g_amiibo.name, s, k); g_amiibo.name[k] = 0;
+    LOG("nfp: amiibo %s (%s) placed on the reader", id_hex, s);
+    void *ev = nfp_find(); pthread_mutex_unlock(&g_nfp_mu);
+    nfp_signal(off); nfp_signal(ev);
+}
+void dm_amiibo_remove(void) {
+    pthread_mutex_lock(&g_nfp_mu);
+    void *ev = NULL;
+    if (g_amiibo.placed) LOG("nfp: amiibo taken off the reader");
+    g_amiibo.placed = 0;
+    if (nfp_has_tag()) { nfp_lose_tag(NFP_STATE_REMOVED); ev = g_nfp_deactivate; }
+    pthread_mutex_unlock(&g_nfp_mu);
+    nfp_signal(ev);
+}
+int dm_amiibo_placed(char out_hex[17]) {
+    pthread_mutex_lock(&g_nfp_mu);
+    int placed = g_amiibo.placed;
+    if (placed && out_hex) for (int i = 0; i < 8; i++) snprintf(out_hex + 2 * i, 3, "%02x", g_amiibo.id[i]);
+    pthread_mutex_unlock(&g_nfp_mu);
+    return placed;
+}
 
