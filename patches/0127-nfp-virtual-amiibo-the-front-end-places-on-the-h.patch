+// Create writes the tag at once, as Horizon's does (no Flush needed); Recreate replaces an area that is there
+static Result nfp_create_area(const NfpAreaCreateInfo *info, int replace, const char *what) {
+    if (!info || info->size > NFP_AREA_SIZE || (info->size && !info->data)) return NFP_RES_INVALID_ARGUMENT;
+    pthread_mutex_lock(&g_nfp_mu);
+    if (atomic_load(&g_nfp_state) != NFP_STATE_MOUNTED) { pthread_mutex_unlock(&g_nfp_mu); return nfp_no_tag(what); }
+    uint8_t area[NFP_AREA_SIZE]; uint32_t counter = 0;
+    if (!replace && nfp_area_load(info->access_id, area, &counter)) { pthread_mutex_unlock(&g_nfp_mu); return NFP_RES_AREA_EXISTS; }
+    memset(area, 0, sizeof area); if (info->size) memcpy(area, info->data, info->size);
+    Result r = nfp_area_store(info->access_id, area, counter + 1);
+    if (g_amiibo.area_open && g_amiibo.area_id == info->access_id) { memcpy(g_amiibo.area, area, sizeof area); g_amiibo.counter = counter + 1; g_amiibo.dirty = 0; }
+    pthread_mutex_unlock(&g_nfp_mu);
+    LOG("nfp: application area for access ID %#x %s (%u bytes)", info->access_id, replace ? "recreated" : "created", info->size); return r;
+}
