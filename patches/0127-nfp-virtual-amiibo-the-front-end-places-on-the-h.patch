diff --git a/dm/host/hle_sdk16.c b/dm/host/hle_sdk16.c
index e656b6e..13a586c 100644
--- a/dm/host/hle_sdk16.c
+++ b/dm/host/hle_sdk16.c
@@ -222,61 +222,307 @@ HLE_FORCE("_ZN2nn3nfc12IsNfcEnabledEv", "NFC switched on or off (returns bool):
 
 // ---------- nfp: amiibo ----------
 // From Mario 1.2.1 the game initializes nfp at boot (v0 did not use it). The real SDK would connect to the sm: service, which the host lacks → abort, so the whole family is taken over.
-// The host has no NFC reader: it reports one NFC device on the currently connected controller (same as hle_hid.c) whose detection never finds a tag -- the same as real hardware with no amiibo at hand:
-// the game's "touch an amiibo" screen appears as usual and cancelling leaves it. Operations that need a tag (mount, application area read / write, amiibo settings applets) all return "tag not found".
-// The game attaches no activate / deactivate events; it polls GetDeviceState to see whether a tag is there.
+// The host has one NFC device, on the currently connected controller (same as hle_hid.c). Its reader holds a virtual amiibo when the player places one from the front end's in-game
+// menu (dm_amiibo_place, front.h). An amiibo is its 8-byte ID (character, variant, type, model number, series): that is what a game reads to know the figure, so no figure's dump
+// and no key is needed. With none placed, detection never finds a tag, as on a console with no amiibo at hand: the game's "touch an amiibo" screen appears and cancelling leaves it,
+// and the operations that need a tag answer "tag not found".
+// A placed amiibo is found when the game searches (at StartDetection, or at once when it is already searching), which signals the activate event; a game that attached none polls
+// GetDeviceState. The game mounts the tag and reads its tag, model, common and register info and its application area. When it stops detection after it found the tag, the amiibo
+// leaves the reader, as a player lifts a figure once the game has read it: the next search needs another pick. Taken off from the menu (dm_amiibo_remove), it signals the deactivate event.
+// Application areas: a real amiibo holds one game's area, and a game that finds another's must have it erased; a virtual one keeps one per access ID, so it is every game's at once.
+// Each is <DM_AMIIBO_DIR>/<amiibo ID>/<access ID>.bin: the 216 bytes, then the write counter (4 bytes, little-endian). DM_AMIIBO_DIR defaults to an amiibo folder beside DM_SAVE.
+// The amiibo settings applets (nickname and owner, game data eraser, restorer) are not on the host: they answer as cancelled, nothing changed.
 // GetState is the library's own state, as on Horizon: 0 until Initialize, 1 until Finalize. Breath of the Wild (main+0x128ec7c) and Tears of the Kingdom (main+0xca5200) call Initialize and attach their
 // availability change event only when GetState is not 1; answering 1 before Initialize skipped the attach, and TotK's poll of that event (main+0x1fb991c) aborted in TryWaitSystemEvent (#613).
-#define NFP_RES_TAG_NOT_FOUND (115u | 97u << 9)   // module 115 (nfp), description 97
-enum { NFP_STATE_INIT = 0, NFP_STATE_SEARCH = 1 };   // 0 initialized, 1 searching for a tag (2 = tag found, never on the host)
+#define NFP_RES(d) (115u | (uint32_t)(d) << 9)   // module 115 (nfp)
+#define NFP_RES_TAG_NOT_FOUND NFP_RES(97)
+#define NFP_RES_INVALID_ARGUMENT NFP_RES(65)
+#define NFP_RES_AREA_NOT_CREATED NFP_RES(128)   // OpenApplicationArea: no area for this access ID yet, the game creates one
+#define NFP_RES_AREA_EXISTS NFP_RES(168)        // CreateApplicationArea: this access ID has one already
+// Device states: 0 initialized, 1 searching for a tag, 2 tag found, 3 tag removed, 4 tag mounted
+enum { NFP_STATE_INIT = 0, NFP_STATE_SEARCH = 1, NFP_STATE_FOUND = 2, NFP_STATE_REMOVED = 3, NFP_STATE_MOUNTED = 4 };
 typedef struct { uint32_t id; uint8_t reserved[4]; } NfpDeviceHandle;
 #define NFP_DEVICE_ID 0x4e465030u   // 'NFP0'
+#define NFP_AREA_SIZE 216   // an amiibo's application area (0xd8 bytes)
+// The SDK's structures, as the nfp service fills them
+typedef struct { uint16_t year; uint8_t month, day; } NfpDate;
+typedef struct { uint8_t uid[10]; uint8_t uid_length; uint8_t reserved1[21]; uint32_t protocol, type; uint8_t reserved2[48]; } NfpTagInfo;
+// character_id keeps the tag's two bytes as they are; model_number is the number (the tag stores it big-endian)
+typedef struct { uint8_t character_id[2]; uint8_t variant, figure_type; uint16_t model_number; uint8_t series; uint8_t reserved[57]; } NfpModelInfo;
+typedef struct { NfpDate last_write; uint16_t write_counter, version; uint32_t area_size; uint8_t reserved[52]; } NfpCommonInfo;
+typedef struct { uint8_t mii[0x58]; NfpDate first_write; char nickname[41]; uint8_t font_region; uint8_t reserved[122]; } NfpRegisterInfo;
+typedef struct { uint32_t access_id; uint32_t pad; const void *data; uint32_t size; uint8_t reserved[48]; } NfpAreaCreateInfo;
+_Static_assert(sizeof(NfpTagInfo) == 0x58 && sizeof(NfpModelInfo) == 0x40 && sizeof(NfpCommonInfo) == 0x40 && sizeof(NfpRegisterInfo) == 0x100, "nfp structure sizes");
+void hle_mii_default_charinfo(void *out);   // hle_mii.c: the system's default Mii, the owner of a virtual amiibo
+static pthread_mutex_t g_nfp_mu = PTHREAD_MUTEX_INITIALIZER;
 static _Atomic int g_nfp_state;
 static _Atomic int g_nfp_lib;   // the library state GetState answers: 0 uninitialized, 1 initialized
+static void *g_nfp_activate, *g_nfp_deactivate;   // the game's events (under g_nfp_mu)
+static struct {   // the reader (under g_nfp_mu)
+    int placed;                // a virtual amiibo is on it
+    uint8_t id[8];             // its ID
+    char name[41];             // its nickname: the amiibo's name, up to 10 characters
+    int area_open;             // OpenApplicationArea succeeded since the mount
+    uint32_t area_id;
+    uint8_t area[NFP_AREA_SIZE];
+    uint32_t counter;          // the open area's write counter
+    int dirty;                 // SetApplicationArea since the last Flush
+} g_amiibo;
 uint32_t hle_hid_connected_npad(void);
 static Result nfp_no_tag(const char *what) {
-    static _Atomic int logged; if (!atomic_exchange(&logged, 1)) LOG("nfp: %s and other operations that need an amiibo tag → no tag found (the host has no NFC)", what);
+    static _Atomic int logged; if (!atomic_exchange(&logged, 1)) LOG("nfp: %s and other operations that need an amiibo tag → no tag found (no amiibo on the reader)", what);
     return NFP_RES_TAG_NOT_FOUND;
 }
-HLE_FORCE("_ZN2nn3nfp10InitializeEv", "amiibo library init; the host has one NFC device that never finds a tag", void, h_nfp_Init, void) { atomic_store(&g_nfp_lib, 1); LOG("nfp::Initialize: the host has one NFC device and finds no amiibo tag"); }
-// Kirby Air Riders initializes it with this one instead; on the host the extended application area is no different, as no tag ever has one
-HLE_FORCE("_ZN2nn3nfp37InitializeWithExtendedApplicationAreaEv", "amiibo library init with the extended application area; the same device that never finds a tag", void, h_nfp_InitExt, void) { atomic_store(&g_nfp_lib, 1); LOG("nfp::InitializeWithExtendedApplicationArea: the host has one NFC device that never finds a tag"); }
+static int nfp_has_tag(void) { int s = atomic_load(&g_nfp_state); return s == NFP_STATE_FOUND || s == NFP_STATE_MOUNTED; }
+static void nfp_today(NfpDate *d) {
+    time_t t = time(NULL); struct tm tm; localtime_r(&t, &tm);
+    d->year = (uint16_t)(tm.tm_year + 1900); d->month = (uint8_t)(tm.tm_mon + 1); d->day = (uint8_t)tm.tm_mday;
+}
+// The folder of the amiibo on the reader, <DM_AMIIBO_DIR or the amiibo folder beside DM_SAVE>/<ID> (under g_nfp_mu), created on the way when make is set; NULL when there is
+// neither variable. The paths are on the heap: a hook runs on the game's thread, whose stack can be 8 KB
+static char *nfp_dir(int make) {
+    char *base = NULL; const char *d = getenv("DM_AMIIBO_DIR");
+    if (d && *d) base = strdup(d);
+    else {
+        const char *save = getenv("DM_SAVE"); if (!save || !*save) return NULL;
+        char *s = strdup(save); if (!s) return NULL;
+        size_t l = strlen(s); while (l > 1 && s[l - 1] == '/') s[--l] = 0;
+        char *slash = strrchr(s, '/');
+        if (slash) { *slash = 0; if (asprintf(&base, "%s/amiibo", s) < 0) base = NULL; }
+        free(s);
+    }
+    if (!base) return NULL;
+    const uint8_t *id = g_amiibo.id; char *out = NULL;
+    if (asprintf(&out, "%s/%02x%02x%02x%02x%02x%02x%02x%02x", base, id[0], id[1], id[2], id[3], id[4], id[5], id[6], id[7]) < 0) out = NULL;
+    if (make && out) { mkdir(base, 0755); mkdir(out, 0755); }
+    free(base); return out;
+}
+static char *nfp_area_path(uint32_t access_id, int make) {
+    char *dir = nfp_dir(make), *p = NULL; if (!dir) return NULL;
+    if (asprintf(&p, "%s/%08x.bin", dir, access_id) < 0) p = NULL;
+    free(dir); return p;
+}
+// The area of access_id from its file (under g_nfp_mu): 1 when there is one
+static int nfp_area_load(uint32_t access_id, uint8_t area[NFP_AREA_SIZE], uint32_t *counter) {
+    char *p = nfp_area_path(access_id, 0); if (!p) return 0;
+    FILE *f = fopen(p, "rb"); free(p); if (!f) return 0;
+    uint8_t buf[NFP_AREA_SIZE + 4] = {0}; size_t got = fread(buf, 1, sizeof buf, f); fclose(f);
+    if (got < NFP_AREA_SIZE) return 0;
+    memcpy(area, buf, NFP_AREA_SIZE);
+    *counter = got >= sizeof buf ? (uint32_t)buf[NFP_AREA_SIZE] | (uint32_t)buf[NFP_AREA_SIZE + 1] << 8 | (uint32_t)buf[NFP_AREA_SIZE + 2] << 16 | (uint32_t)buf[NFP_AREA_SIZE + 3] << 24 : 0;
+    return 1;
+}
+// Written to a temporary file and renamed over the old one, so a crash mid-write keeps the previous area
+static Result nfp_area_store(uint32_t access_id, const uint8_t area[NFP_AREA_SIZE], uint32_t counter) {
+    char *p = nfp_area_path(access_id, 1), *tmp = NULL;
+    if (!p) { LOG("[RED] nfp: no DM_AMIIBO_DIR or DM_SAVE, the amiibo's application area is not kept"); return RES_OK; }
+    if (asprintf(&tmp, "%s.tmp", p) < 0) { free(p); return RES_OK; }
+    uint8_t buf[NFP_AREA_SIZE + 4]; memcpy(buf, area, NFP_AREA_SIZE);
+    for (int i = 0; i < 4; i++) buf[NFP_AREA_SIZE + i] = (uint8_t)(counter >> (8 * i));
+    FILE *f = fopen(tmp, "wb");
+    int ok = f && fwrite(buf, 1, sizeof buf, f) == sizeof buf;
+    if (f && fclose(f) != 0) ok = 0;
+    if (!ok) LOG("[RED] nfp: writing %s failed", tmp);
+    else if (rename(tmp, p) != 0) LOG("[RED] nfp: %s could not replace %s", tmp, p);
+    free(tmp); free(p); return RES_OK;
+}
+static void nfp_signal(void *ev) { if (ev) hle_signal_bound_system_event(ev); }
+// The reader finds the amiibo (under g_nfp_mu): returns the event to signal outside the lock
+static void *nfp_find(void) {
+    if (!g_amiibo.placed || atomic_load(&g_nfp_state) != NFP_STATE_SEARCH) return NULL;
+    atomic_store(&g_nfp_state, NFP_STATE_FOUND);
+    LOG("nfp: amiibo %02x%02x%02x%02x%02x%02x%02x%02x (%s) found", g_amiibo.id[0], g_amiibo.id[1], g_amiibo.id[2], g_amiibo.id[3], g_amiibo.id[4], g_amiibo.id[5], g_amiibo.id[6], g_amiibo.id[7], g_amiibo.name);
+    return g_nfp_activate;
+}
+// The tag leaves the reader (under g_nfp_mu): an unflushed application area is dropped, as on a tag lifted before the write
+static void nfp_lose_tag(int state) {
+    g_amiibo.area_open = 0; g_amiibo.dirty = 0;
+    atomic_store(&g_nfp_state, state);
+}
+
+HLE_FORCE("_ZN2nn3nfp10InitializeEv", "amiibo library init; one NFC device, which finds an amiibo the player places from the in-game menu", void, h_nfp_Init, void) { atomic_store(&g_nfp_lib, 1); LOG("nfp::Initialize: one NFC device; amiibo come from the in-game menu"); }
+// Kirby Air Riders initializes it with this one instead. The extended application area is not on the host's tags: those calls answer "tag not found"
+HLE_FORCE("_ZN2nn3nfp37InitializeWithExtendedApplicationAreaEv", "amiibo library init with the extended application area; the same device", void, h_nfp_InitExt, void) { atomic_store(&g_nfp_lib, 1); LOG("nfp::InitializeWithExtendedApplicationArea: one NFC device; amiibo come from the in-game menu"); }
 HLE_FORCE("_ZN2nn3nfp29AttachAvailabilityChangeEventEPNS_2os15SystemEventTypeE", "NFC availability change event; bound to a kernel event, never signalled", void, h_nfp_AttachAvail, void *ev) { hle_bind_system_event(ev, 0); }
 HLE_FORCE("_ZN2nn3nfp11ListDevicesEPNS0_12DeviceHandleEPii", "NFC device list: one device", Result, h_nfp_List, NfpDeviceHandle *out, int *n, int max) {
     *n = 0; if (max >= 1) { memset(&out[0], 0, sizeof out[0]); out[0].id = NFP_DEVICE_ID; *n = 1; }
     return RES_OK;
 }
 HLE_FORCE("_ZN2nn3nfp9GetNpadIdEPjRKNS0_12DeviceHandleE", "controller the NFC device is on: the one connected now", Result, h_nfp_NpadId, uint32_t *out, const NfpDeviceHandle *h) { (void)h; *out = hle_hid_connected_npad(); return RES_OK; }
-HLE_FORCE("_ZN2nn3nfp14StartDetectionERKNS0_12DeviceHandleE", "start tag detection (never finds one)", Result, h_nfp_Start, const NfpDeviceHandle *h) { (void)h; atomic_store(&g_nfp_state, NFP_STATE_SEARCH); return RES_OK; }
-HLE_FORCE("_ZN2nn3nfp13StopDetectionERKNS0_12DeviceHandleE", "stop tag detection", Result, h_nfp_Stop, const NfpDeviceHandle *h) { (void)h; atomic_store(&g_nfp_state, NFP_STATE_INIT); return RES_OK; }
-HLE_FORCE("_ZN2nn3nfp14GetDeviceStateERKNS0_12DeviceHandleE", "device state: initialized / searching for a tag", int, h_nfp_State, const NfpDeviceHandle *h) { (void)h; return atomic_load(&g_nfp_state); }
-HLE_FORCE("_ZN2nn3nfp10GetTagInfoEPNS0_7TagInfoERKNS0_12DeviceHandleE", "tag info: no tag", Result, h_nfp_TagInfo, void *out, const NfpDeviceHandle *h) { (void)out; (void)h; return nfp_no_tag("GetTagInfo"); }
-HLE_FORCE("_ZN2nn3nfp12GetModelInfoEPNS0_9ModelInfoERKNS0_12DeviceHandleE", "model info: no tag", Result, h_nfp_ModelInfo, void *out, const NfpDeviceHandle *h) { (void)out; (void)h; return nfp_no_tag("GetModelInfo"); }
-HLE_FORCE("_ZN2nn3nfp5MountERKNS0_12DeviceHandleENS0_9ModelTypeENS0_11MountTargetE", "mount tag: no tag", Result, h_nfp_Mount, const NfpDeviceHandle *h, int model, int target) { (void)h; (void)model; (void)target; return nfp_no_tag("Mount"); }
-// Another group The Legend of Zelda: Breath of the Wild (SDK 20) uses: tag activate / deactivate events (bound to a kernel event that never fires; without the take-over the SDK's code reads a null pointer at sdk+0x3f2a78), the two-argument Mount,
